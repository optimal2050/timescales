# Phase-2 C++ header tree; empty until then, so keep it out of the build.
# Note: must NOT be `^inst$` -- that would also drop the `inst/doc` directory
# that vignette building creates, and installing vignettes would fail.
^inst/include$
# Apache-2.0 is a standard R license abbreviation, so the text is not shipped.
^LICENSE$
